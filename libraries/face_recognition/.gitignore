# -------------------------------------------------------------------------
# PYTHON FACE_RECOGNITION MICROSERVICE .gitignore
# -------------------------------------------------------------------------

# 1. Virtual Environment (Crucial)
# Exclude the entire Python environment directory
/venv
# Also exclude the Python environment directory if created under a different name
/face_recognition_venv
# Ignore dependency installation logs
pip-log.txt
pip-delete-this-file.txt

# 2. Bytecode and Cache Files
# Exclude compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# 3. CRITICAL: Locally Generated Data
# Ignore the file containing all face embeddings, as it is large and binary.
# It should be generated locally by encode_faces.py, not committed.
encodings.pickle

# 4. Gunicorn and Runtime Files
# Ignore any process ID files Gunicorn might create
gunicorn.pid

# 5. Runtime and Log Files
# Ignore temporary logs and debugging files
*.log
*.temp
*.frame

# 6. IDE and OS Files
.vscode/
.idea/
.DS_Store
*~

# 7 config file
/config.py
./config.py
config.py
face_recognition.service
run_gunicorn.sh
